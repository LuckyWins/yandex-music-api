# Environment for local development and the scripts in examples/.
#
# This file is committed and documents every variable the project understands.
# It must never hold a real value. Its twin, .env.local, is git-ignored, written
# owner-only, and is where the real credentials go:
#
#     cp .env.local.example .env.local
#
# Variables set in the real environment take precedence over the file, so CI and
# one-off runs can supply a value without writing anything to disk:
#
#     YANDEX_MUSIC_TOKEN=... php examples/account_status.php
#
# Nothing in src/ reads either file. Loading configuration is the consuming
# application's job; only examples/Bootstrap.php reads them, and only so the
# example scripts have somewhere to keep a token. The test suite needs neither.
#
# When adding a variable: document what it is, what happens without it, and how
# to obtain it. Keep the placeholder obviously fake.


# OAuth token for the Yandex.Music API.
#
# Required by every example except device_auth.php, which is what produces it:
#
#     php examples/device_auth.php
#
# That script writes the token here for you and never prints it. Without a
# token the API still answers, but only with what an anonymous visitor may see —
# thirty-second previews rather than whole tracks.
#
# Treat it like a password. It grants full access to the account: the profile,
# the real name and birthday, the phone numbers on the Yandex ID, the
# subscription, the listening history, and the ability to change playlists and
# likes. It is valid for about a year and this library never refreshes it.
#
# If it leaks, revoke it:
#
#     php examples/revoke_token.php
#
# That script revokes the token, confirms the API now refuses it, and removes it
# from this file. Ending the session in Yandex ID does NOT invalidate a token.
YANDEX_MUSIC_TOKEN=y0_PUT_YOUR_TOKEN_HERE_THIS_IS_NOT_A_REAL_ONE


# Address overrides for networks where Yandex is unreachable.
#
# Optional. Some networks — corporate VPNs especially — block Yandex over IPv4
# while leaving IPv6 alone, and the system resolver hands out only the IPv4
# address. Every request then hangs until it times out, which looks exactly like
# the API being down.
#
# Set this to a comma-separated list of curl resolve entries to route around it.
# Look the addresses up first, because Yandex changes them:
#
#     host -t AAAA oauth.yandex.ru
#     host -t AAAA api.music.yandex.net
#
# Leave it unset on a normal connection.
# YANDEX_MUSIC_RESOLVE=oauth.yandex.ru:443:[2a02:6b8::15e],api.music.yandex.net:443:[2a02:6b8::5:246]
